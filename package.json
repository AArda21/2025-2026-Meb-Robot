{
  "name": "meb-robot-sim",
  "version": "4.3.0",
  "description": "MEB Robot Yumurta Toplama Simülatörü (Arduino kodu + 3B Rapier fizik motoru)",
  "main": "electron/main.js",
  "author": "Eyüp Ensar",
  "license": "MIT",
  "scripts": {
    "libs": "node scripts/copy-libs.js",
    "pc": "npm run libs && electron .",
    "exe": "npm run libs && electron-builder --win portable --publish never",
    "apk:hazirla": "npm run libs && npx cap add android && npx cap sync android",
    "apk:guncelle": "npm run libs && npx cap sync android",
    "apk:ac": "npx cap open android"
  },
  "dependencies": {
    "three": "0.160.0",
    "@dimforge/rapier3d-compat": "0.12.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "@capacitor/core": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/android": "^6.2.0"
  },
  "build": {
    "appId": "com.eyup.mebrobotsim",
    "productName": "MEB Robot V4.3",
    "files": [
      "electron/**",
      "www/**",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "directories": {
      "output": "dist"
    },
    "portable": {
      "artifactName": "MEB-Robot-V${version}.exe"
    }
  }
}